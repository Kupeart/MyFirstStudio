[node name="Mouse" type="Label" parent="UI/HelpPanel/HelpBox" unique_id=1304678061]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "• גלגלת אמצעית בגרירה — סיבוב סביב העצם
• Shift + גלגלת אמצעית — הזזת התצוגה
• Ctrl + גלגלת אמצעית — זום
• גלגלת — זום פנימה והחוצה"
horizontal_alignment = 2

[node name="Keys" type="Label" parent="UI/HelpPanel/HelpBox" unique_id=1320148633]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "• W A S D + Q E — תנועה חופשית
• Shift — תנועה מהירה
• F — מיקוד חזרה למרכז"
horizontal_alignment = 2

[node name="Objects" type="Label" parent="UI/HelpPanel/HelpBox" unique_id=672676424]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "• קליק על עצם — בוחרים אותו
• Shift + קליק על עצם — מוסיפים או מסירים מהבחירה
• Shift + גרירה — מלבן בחירה לכמה עצמים
• כמה עצמים נבחרים — גיזמו משותף אחד מזיז את כולם
• גרירת החצים הצבעוניים — מזיזים אותו
• גרירת הריבוע הצהוב — הזזה חופשית על הרצפה
• גרירת טבעת צבעונית — סיבוב סביב הציר
• ההנדלים הצבעוניים בקצוות השולחן — שינוי רוחב, עומק וגובה
• ארגז הכלים שמשמאל לשולחן — חלון עריכת חומריות
• חצים במקלדת — סיבוב 15 מעלות
• Delete — מחיקה, Ctrl+D — שכפול
• Shift בזמן גרירת גיזמו — הצמדה לרשת
• קליק ימני — ביטול כל השינויים וחזרה למצב הקודם"
horizontal_alignment = 2

