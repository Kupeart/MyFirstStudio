[gd_resource type="StandardMaterial3D" format=3]

; מסגרת הסימון של העצם הנבחר.
;
; איך זה עובד: החומר מוצב כ-material_overlay על כל אחד מחלקי המודל.
; הוא מצייר "קליפה" מוגדלת (grow) של המודל, אבל רק את הצדדים הפנימיים
; שלה (cull_mode = front). מה שנשאר רואים הוא מסגרת דקה מסביב לכל הצללית
; של העצם - בלי להוסיף שום גיאומטריה למודל.
;
; כדי להפוך את המסגרת לעבה יותר - מגדילים את grow_amount.

[resource]
resource_name = "SelectionOutline"
shading_mode = 0
albedo_color = Color(1, 0.85, 0.15, 1)
cull_mode = 1
grow = true
grow_amount = 0.03
